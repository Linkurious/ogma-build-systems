{
  "name": "@linkurious/create-ogma",
  "version": "1.0.0",
  "description": "Create an Ogma project from a build system template.",
  "type": "module",
  "bin": {
    "create-ogma": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "npm run test",
    "prepack": "bash scripts/prepack.sh",
    "postpack": "bash scripts/postpack.sh",
    "posttest": "concurrently \"npm run build:vite\" \"npm run build:rollup\" \"npm run build:webpack\" \"npm run build:typescript\" \"npm run build:node\" \"npm run build:parcel\"",
    "build:vite": "cd templates/vite && npm run build",
    "build:rollup": "cd templates/rollup && npm run build",
    "build:webpack": "cd templates/webpack && npm run build",
    "build:typescript": "cd templates/typescript && npm run build",
    "build:node": "cd templates/node && npm run build",
    "build:parcel": "cd templates/parcel && npm run build",
    "prepare": "node scripts/prepare.mjs && concurrently \"npm run prepare:vite\" \"npm run prepare:rollup\" \"npm run prepare:webpack\" \"npm run prepare:typescript\" \"npm run prepare:node\" \"npm run prepare:parcel\" && node scripts/cleanup.mjs",
    "prepare:vite": "cd templates/vite && npm i",
    "prepare:rollup": "cd templates/rollup && npm i",
    "prepare:webpack": "cd templates/webpack && npm i",
    "prepare:typescript": "cd templates/typescript && npm i",
    "prepare:node": "cd templates/node && npm i",
    "prepare:parcel": "cd templates/parcel && npm i --ignore-scripts",
    "prepublishOnly": "npm run build",
    "postversion": "sync_versions"
  },
  "keywords": [
    "ogma",
    "create",
    "template",
    "vite",
    "webpack"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@clack/prompts": "1.1.0",
    "@linkurious/code-tools": "0.2.0",
    "@linkurious/ogma": ">=6.0.2",
    "@types/node": "^22.0.0",
    "concurrently": "9.0.0",
    "mri": "1.2.0",
    "picocolors": "1.1.1",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  }
}
